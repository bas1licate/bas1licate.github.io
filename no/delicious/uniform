<!ELEMENT chef (recipe)*> <!-- <!DOCTYPE chef> --> <!ATTLIST chef inline (never | always) "never" ignore CDATA #IMPLIED>
<!ELEMENT recipe (about?,ilist,time?,preheat?,method)> <!ATTLIST recipe title CDATA #REQUIRED serves CDATA "0">
<!ELEMENT about (#PCDATA)>
<!ELEMENT ilist (ingredient)*>
<!ELEMENT ingredient (#PCDATA)> <!ATTLIST ingredient value CDATA "-0" measure CDATA "">
<!ELEMENT time EMPTY> <!ATTLIST time time CDATA #REQUIRED unit CDATA #REQUIRED>
<!ELEMENT preheat EMPTY> <!ATTLIST preheat temperature CDATA #REQUIRED mark CDATA "">
<!ELEMENT method (take|put|fold|add|remove|combine|divide|adddry|liquefy|stir|mix|clean|pour|loop|break|serve|refrigerate)*>
<!ELEMENT take (#PCDATA)>
<!ELEMENT put (#PCDATA)> <!ATTLIST put n CDATA "1">
<!ELEMENT fold (#PCDATA)> <!ATTLIST fold n CDATA "1">
<!ELEMENT add (#PCDATA)> <!ATTLIST add n CDATA "1">
<!ELEMENT remove (#PCDATA)> <!ATTLIST remove n CDATA "1">
<!ELEMENT combine (#PCDATA)> <!ATTLIST combine n CDATA "1">
<!ELEMENT divide (#PCDATA)> <!ATTLIST divide n CDATA "1">
<!ELEMENT adddry EMPTY> <!ATTLIST adddry n CDATA "1">
<!ELEMENT liquefy EMPTY> <!ATTLIST liquefy type (ingredient | contents) "ingredient" value CDATA #IMPLIED>
<!ELEMENT stir (#PCDATA)> <!ATTLIST stir type (number | ingredient) #REQUIRED n CDATA "1">
<!ELEMENT mix EMPTY> <!ATTLIST mix n CDATA "1">
<!ELEMENT clean EMPTY> <!ATTLIST clean n CDATA "1">
<!ELEMENT pour EMPTY> <!ATTLIST pour n CDATA "1" p CDATA "1">
<!ELEMENT loop (#PCDATA)> <!ATTLIST loop type (start | end) #REQUIRED name CDATA #IMPLIED evil CDATA #IMPLIED> <!-- only case pcdata isn't required -->
<!ELEMENT break EMPTY>
<!ELEMENT serve (#PCDATA)>
<!ELEMENT refrigerate EMPTY> <!ATTLIST refrigerate value CDATA "0">
